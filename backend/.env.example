PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_commerce_layer?schema=public"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.5-flash-lite"
RAZORPAY_KEY_ID="rzp_test_YOUR_TEST_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_TEST_KEY_SECRET"
# Comma-separated list of allowed frontend origins for CORS in a real
# deployment (e.g. "https://app.example.com,https://admin.example.com").
# Leave unset for local development — CORS stays permissive by default.
ALLOWED_ORIGINS=
# Phase 6: rate limiting is only enforced when NODE_ENV=production. Set
# FORCE_RATE_LIMIT=1 to test the 429 behavior locally without production mode.
# NODE_ENV=production
# FORCE_RATE_LIMIT=1
